{
  "name": "recolhetudo",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:run": "jest --runInBand --no-coverage",
    "test:debug": "jest --runInBand --detectOpenHandles --no-coverage",
    "backend:start": "npm --prefix backend run start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:check": "npm --prefix backend run check",
    "docker:test": "docker-compose run --rm test",
    "docker:dev": "docker-compose up dev",
    "docker:build": "docker-compose build",
    "docker:clean": "docker-compose down -v",
    "docker:ci": "docker-compose build && docker-compose run --rm test",
    "docker:shell": "docker-compose run --rm test /bin/sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.12",
    "@react-navigation/native": "^7.1.8",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-font": "~13.3.2",
    "expo-location": "~18.1.6",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.14.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.14",
    "@types/react-dom": "~19.0.6",
    "@types/react-native": "^0.72.8",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.9",
    "typescript": "~5.8.3"
  },
  "private": true
}
